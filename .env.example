# PostgreSQL source adapter
SOURCE_ADAPTER=json
POSTGRES_DSN=postgresql://ontology:ontology_dev_password@127.0.0.1:5433/business_ontology

# Graph store: networkx or neo4j
GRAPH_STORE=networkx
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password

# Source adapter: json, csv, http, document, or postgresql
CSV_SOURCE_DIR=./data/csv
HTTP_JSON_URL=http://127.0.0.1:8080/ontology-facts
HTTP_TIMEOUT_SECONDS=10
DOCUMENT_SOURCE_DIR=./data/documents

# Dynamic data
# Optional path to a different ontology definition (default: data/ontology.json)
# ONTOLOGY_PATH=./data/ontology.json
# Reload facts from the source when they are older than this many seconds (0 = only on reload_data)
REFRESH_INTERVAL_SECONDS=0
