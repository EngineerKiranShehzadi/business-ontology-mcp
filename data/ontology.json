{
  "ontology_name": "Small Sales Ontology",
  "ontology_version": "1.1",
  "entities": {
    "Customer": {
      "description": "A person or organization that places orders.",
      "properties": {"customer_id": "string", "name": "string", "status": "string"},
      "id_field": "customer_id"
    },
    "Order": {
      "description": "A purchase request created by a customer.",
      "properties": {"order_id": "string", "customer_id": "ref:Customer", "order_date": "date", "status": "string"},
      "id_field": "order_id"
    },
    "Product": {
      "description": "An item that can be included in an order.",
      "properties": {"product_id": "string", "name": "string", "category": "string", "price": "number"},
      "id_field": "product_id"
    }
  },
  "relationships": [
    {
      "name": "PLACES",
      "from": "Customer",
      "to": "Order",
      "description": "A customer creates an order."
    },
    {
      "name": "CONTAINS",
      "from": "Order",
      "to": "Product",
      "description": "An order includes a product.",
      "source": {"table": "order_items", "from_column": "order_id", "to_column": "product_id"}
    }
  ],
  "rules": [
    {
      "name": "PURCHASES",
      "path": ["PLACES", "CONTAINS"],
      "description": "Customer PLACES Order CONTAINS Product => Customer PURCHASES Product"
    }
  ],
  "facts": {
    "customers": [
      {"customer_id": "C001", "name": "Avery Morgan", "status": "active"},
      {"customer_id": "C002", "name": "Jordan Lee", "status": "active"}
    ],
    "orders": [
      {"order_id": "O100", "customer_id": "C001", "order_date": "2026-11-20", "status": "shipped"},
      {"order_id": "O101", "customer_id": "C002", "order_date": "2026-11-21", "status": "processing"}
    ],
    "products": [
      {"product_id": "P100", "name": "Notebook", "category": "Office", "price": 12.50},
      {"product_id": "P200", "name": "Keyboard", "category": "Technology", "price": 48.00}
    ],
    "edges": [
      {"from": "C001", "to": "O100", "relationship": "PLACES"},
      {"from": "C002", "to": "O101", "relationship": "PLACES"},
      {"from": "O100", "to": "P100", "relationship": "CONTAINS"},
      {"from": "O100", "to": "P200", "relationship": "CONTAINS"},
      {"from": "O101", "to": "P100", "relationship": "CONTAINS"}
    ]
  }
}
